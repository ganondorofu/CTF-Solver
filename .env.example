# CTFd Configuration
CTFD_URL=https://demo.ctfd.io
CTFD_TOKEN=ctfd_your_token_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI (GPT)
OPENAI_API_KEY=sk-your_key_here

# Google (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# ZAI API (z.ai / GLM)
ZAI_API_KEY_TTYTB=your_zai_api_key_ttytb
ZAI_API_KEY_SUB=your_zai_api_key_sub

# Kimi API (Moonshot AI)
KIMI_API_KEY_GANONDOROFU=sk-your_kimi_api_key_ganondorofu
KIMI_API_KEY_TTYTB=sk-your_kimi_api_key_ttytb

# GitHub Token (for Copilot CLI auth profiles)
# Note: Copilot CLI uses ~/.copilot/config for authentication
# GITHUB_TOKEN=ghp_your_token_here
